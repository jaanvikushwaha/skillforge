<script>
function toggleMenu(){
 const m=document.getElementById('mobileLinks');
 m.style.display=m.style.display==='none'?'flex':'none';
}
document.getElementById('year').textContent=new Date().getFullYear();
document.querySelectorAll('#mobileLinks a').forEach(a=>a.addEventListener('click',()=>document.getElementById('mobileLinks').style.display='none'));
</script>
