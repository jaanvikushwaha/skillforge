<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Career Paths — SkillForge</title>
<meta name="description" content="Explore career options, skills needed, and salary insights.">
<style>
:root{
  --bg:#07111f; --card:#0d1b2d; --card2:#10243b; --text:#f5f8ff;
  --muted:#a9b8cc; --accent:#6ee7ff; --accent2:#8b7cff; --line:#1d3149;
  --max:1120px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:
radial-gradient(circle at 10% 10%,rgba(110,231,255,.12),transparent 28%),
radial-gradient(circle at 90% 15%,rgba(139,124,255,.14),transparent 30%),var(--bg);
color:var(--text);line-height:1.6}
a{text-decoration:none;color:inherit}
.container{width:min(92%,var(--max));margin:auto}
nav{position:sticky;top:0;z-index:20;background:rgba(7,17,31,.78);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,.07)}
.navin{height:72px;display:flex;align-items:center;justify-content:space-between}
.logo{font-size:1.25rem;font-weight:800;letter-spacing:-.5px}.logo span{color:var(--accent)}
.links{display:flex;gap:25px;color:var(--muted);font-size:.94rem}.links a{transition:.2s}.links a:hover{color:var(--text)}
.menu{display:none;background:none;border:0;color:white;font-size:1.5rem}
.btn{padding:12px 20px;border-radius:12px;font-weight:700;border:1px solid var(--line);transition:.2s;cursor:pointer;display:inline-block}
.primary{background:var(--accent);color:#04101c;border-color:var(--accent)}.primary:hover{transform:translateY(-2px)}
section{padding:90px 0}
.hero{min-height:auto;padding:60px 0;text-align:center}
.badge{display:inline-flex;gap:8px;align-items:center;padding:7px 13px;border:1px solid var(--line);border-radius:999px;color:var(--accent);background:rgba(110,231,255,.06);font-size:.85rem;margin-bottom:22px}
h1{font-size:clamp(2.2rem,5vw,4rem);line-height:1.1;letter-spacing:-2px;max-width:900px;margin:auto}
.gradient{background:linear-gradient(100deg,var(--accent),#b49cff);-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{color:var(--muted);font-size:1.1rem;max-width:700px;margin:20px auto}
h2{font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.1;margin:30px 0 20px;letter-spacing:-1px}
h3{font-size:1.3rem;margin:25px 0 15px;color:var(--text)}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:25px;margin:30px 0}
.card{background:linear-gradient(145deg,rgba(16,36,59,.92),rgba(10,25,42,.92));border:1px solid var(--line);border-radius:20px;padding:25px;transition:.25s}
.card:hover{transform:translateY(-5px);border-color:#315274}
.icon{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;background:rgba(110,231,255,.1);font-size:1.35rem;margin-bottom:15px}
.card h3{margin-top:0;margin-bottom:12px}.card p{color:var(--muted);font-size:.95rem}
.salary{background:rgba(139,124,255,.1);padding:8px 12px;border-radius:8px;font-weight:600;color:var(--accent2);display:inline-block;margin:10px 0}
.skill-tag{display:inline-block;background:rgba(255,255,255,.06);padding:6px 12px;border-radius:999px;margin:4px 4px 4px 0;font-size:.85rem;color:var(--muted)}
.company-list{background:rgba(110,231,255,.05);border-left:3px solid var(--accent);padding:15px;border-radius:8px;margin:15px 0}
.pathway{background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:16px;padding:25px;margin:20px 0}
.pathway h4{color:var(--accent);margin-bottom:12px;font-size:1.1rem}
footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:.85rem;margin-top:60px}
.footerin{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.social{display:flex;gap:18px}.social a:hover{color:var(--accent)}
@media(max-width:800px){
 .links{display:none}.menu{display:block}.grid{grid-template-columns:1fr}.hero{padding:40px 0}h1{letter-spacing:-1.5px}
}
</style>
</head>
